tri_db_bio_exact    |python tri_by_bk.py --mode train --training-in configs/2_tri_training/db_bio/exact.yaml --run-name 50_eval_{task_id} --set training.lr=5e-5 --set training.debug_tri=true --task_id {task_id}
tri_db_bio_more     |python tri_by_bk.py --mode train --training-in configs/2_tri_training/db_bio/more.yaml --run-name 500_random_{task_id} --set training.lr=5e-5 --set training.debug_tri=true --task_id {task_id}
tri_db_bio_more_deid|python tri_by_bk.py --mode train --training-in configs/2_tri_training/db_bio/more_deid.yaml --run-name 500_random_deid_{task_id} --set training.lr=5e-5 --set training.debug_tri=true --task_id {task_id}
