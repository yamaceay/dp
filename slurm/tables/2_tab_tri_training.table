tri_tab_exact    |python tri_by_bk.py --mode train --training-in configs/2_tri_training/tab/exact.yaml --run-name 50_eval_{task_id} --set training.lr=5e-5 --set training.debug_tri=true --task_id {task_id}
tri_tab_more     |python tri_by_bk.py --mode train --training-in configs/2_tri_training/tab/more.yaml --run-name 500_random_{task_id} --set training.lr=5e-5 --set training.debug_tri=true --task_id {task_id}
tri_tab_more_deid|python tri_by_bk.py --mode train --training-in configs/2_tri_training/tab/more_deid.yaml --run-name 500_random_deid_{task_id} --set training.lr=5e-5 --set training.debug_tri=true --task_id {task_id}
