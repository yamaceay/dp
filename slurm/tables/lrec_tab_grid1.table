tab_risk_shap|python model.py   --data tab --data_in data/TAB/splitted/test.json   --model risk --model_in configs/model/risk/tab/shap.yaml   --runtime_in configs/runtime/risk_tolerance/rho_*.yaml   --output jsonl --unique_name tab_risk_shap 
tab_spacy|python model.py   --data tab --data_in data/TAB/splitted/test.json   --model spacy --model_in configs/model/spacy.yaml      --output jsonl --unique_name tab_spacy 
tab_presidio|python model.py   --data tab --data_in data/TAB/splitted/test.json   --model presidio --model_in configs/model/presidio.yaml      --output jsonl --unique_name tab_presidio 
tab_manual|python model.py   --data tab --data_in data/TAB/splitted/test.json   --model manual --model_in configs/model/manual.yaml      --output jsonl --unique_name tab_manual 